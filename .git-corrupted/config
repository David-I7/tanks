[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = git@github.com:David-I7/tanks.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[branch "feature"]
	vscode-merge-base = origin/server
	remote = origin
	merge = refs/heads/feature
[branch "slop"]
	vscode-merge-base = origin/feature
[branch "proto"]
	vscode-merge-base = origin/feature
